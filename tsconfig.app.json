{
  // Browser application source. Vite/esbuild does the emitting; this project only
  // type-checks.
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,

    // `vite/client` supplies `import.meta.env` and the ambient asset modules
    // (*.png, *.svg, *.css). Without it the Figma-imported PNG imports and
    // `import.meta.env.DEV` are type errors even though Vite resolves them.
    // Node types are deliberately ABSENT here — browser code must not reach for
    // `process`, `__dirname`, or Node's Buffer.
    "types": ["vite/client"],

    // Mirrors the `@` alias in vite.config.ts. These must stay in sync; the alias
    // is resolved by Vite at build time and by TypeScript here.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": false,

    // Reported by ESLint (`@typescript-eslint/no-unused-vars`) rather than by the
    // compiler, so a single unused import during editing does not break the
    // type-check the way it would break a build.
    "noUnusedLocals": false,
    "noUnusedParameters": false,

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test",
    "dist",
    "coverage",
    "playwright-report",
    "test-results",
    "node_modules"
  ]
}
