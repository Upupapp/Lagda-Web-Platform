{
  // Vitest unit/component tests, shared test utilities, and Playwright specs.
  //
  // Test globals live ONLY here. Production source cannot see `describe`, `it`,
  // or `expect`, so a stray test helper cannot be imported into the app bundle
  // without the type-check failing.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    // `vitest/globals` for describe/it/expect, `@testing-library/jest-dom` for the
    // DOM matchers, `vite/client` because tests import production modules that
    // rely on `import.meta.env`, and `node` because Playwright specs and the
    // config use Node APIs.
    "types": ["vitest/globals", "@testing-library/jest-dom", "vite/client", "node"],

    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "useUnknownInCatchVariables": true,

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": [
    "src/test/**/*.ts",
    "src/test/**/*.tsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
