# LAGDA frontend — example configuration. Copy to .env.local for local dev
# (.env.local is gitignored by Vite's default pattern; never commit real values).

# Base URL of the local Lagda-Backend API (Fastify, packages/api). Empty/unset
# means every service stays on its mock implementation — see
# src/app/services/backend-flag.ts.
# Must match "localhost" (not 127.0.0.1) if the backend's CORS_ORIGINS and
# session cookie are scoped to http://localhost:5173 — browsers treat
# localhost and 127.0.0.1 as different sites for cookie same-site purposes,
# even on the same machine, so a mismatch here silently breaks session
# persistence despite CORS otherwise looking fine.
VITE_API_BASE_URL=http://localhost:8090

# Firebase Web client config — VERIFICATION ONLY (P2 migration). Only needed
# when Lagda-Backend has EMAIL_VERIFICATION_PROVIDER=firebase set; harmless
# to leave unset otherwise, see src/app/services/firebase-config.ts. These
# are CLIENT identifiers, not secrets — Firebase's own access control is
# server-side (Admin SDK/security rules), never enforced by hiding this key.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
